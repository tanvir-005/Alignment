SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Requests per minute per IP. The Next.js server proxies everyone, so keep this generous.
MAX_REQUESTS=600

# ---- email -------------------------------------------------------------
# Default prints emails in the server console (demo). For real sending:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
#   EMAIL_HOST=smtp.example.com
#   EMAIL_PORT=587
#   EMAIL_HOST_USER=...
#   EMAIL_HOST_PASSWORD=...
#   EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=Teamboard <noreply@teamboard.local>
# Base URL of the frontend, used for links inside emails.
FRONTEND_URL=http://localhost:3000
# The 10 PM digest uses this timezone, e.g. Asia/Dhaka.
TIME_ZONE=UTC
